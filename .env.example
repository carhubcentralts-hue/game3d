# ─── ProSaaS Tools Environment Configuration ───

# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/prosaas?schema=public"

# Cloudflare R2 Storage (leave empty to use local storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Local storage fallback path (used when R2 is not configured)
STORAGE_LOCAL_PATH=./storage

# Auth
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Render Service
RENDER_SERVICE_URL="http://localhost:4010"
RENDER_PORT=4010

# App
NEXT_PUBLIC_APP_NAME="ProSaaS Tools"
NEXT_PUBLIC_RENDER_SERVICE_URL="http://localhost:4010"

# Logging
LOG_LEVEL=info
NODE_ENV=development
